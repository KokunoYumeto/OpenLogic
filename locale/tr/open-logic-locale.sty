\renewcommand*{\ollicensetext}[3]
  {\textit{#1}, #2 tarafından hazırlanmış ve #3 ile lisanslanmıştır.}
\renewcommand*{\olshortlicensetext}[1]
  {\textit{\href{\OLTlinkname}{\jobname}}, #1 / 
  \href{http://creativecommons.org/licenses/by/4.0/}{CC--BY}.}
\renewcommand*{\oluselicensetext}
  {Bu çalışma, \href{http://openlogicproject.org/}{\OLPname} tarafından
  hazırlanmış \textit{\href{\OLTlinkname}{\OLTname}} temel alınarak,
  \href{http://creativecommons.org/licenses/by/4.0/}{\licensename}
  kapsamında kullanılmıştır.}
\renewcommand*{\olshortuselicensetext}[2]
