% Pilihan istilah Bahasa Indonesia untuk unit pembaca Open Logic.
% Berkas ini dimuat sesudah konfigurasi utama, sehingga hanya token yang
% berbeda dari bahasa sumber yang perlu didefinisikan ulang.

% Sumber UI menggunakan "elemen" dan "anggota" sebagai sinonim, sedangkan
% modul UT secara konsisten memakai "anggota himpunan" dalam definisi.
\settexttoken{element}{anggota}{anggota}[Anggota][Anggota]

% Bahasa Indonesia tidak memakai artikel tak tentu a/an. Pertahankan bentuk
% token !!a{element} di sumber, tetapi kosongkan keluaran artikelnya.
\definetoken{a}{element}{}
\definetoken{A}{element}{}

% Istilah fungsi mengikuti buku teks Konsep Dasar Matematika UIN KHAS:
% fungsi injektif, surjektif, dan bijektif; bentuk nomina Indonesianya
% adalah injeksi, surjeksi, dan bijeksi. Bentuk tunggal dan jamak sama.
\settexttoken{injective}*{injektif}{injektif}
\settexttoken{injection}*{injeksi}{injeksi}
\settexttoken{surjective}{surjektif}{surjektif}
\settexttoken{surjection}{surjeksi}{surjeksi}
\settexttoken{bijective}{bijektif}{bijektif}
\settexttoken{bijection}{bijeksi}{bijeksi}

% Artikel tak tentu bahasa Inggris pada token fungsi tidak mempunyai
% padanan yang perlu dicetak dalam bahasa Indonesia.
\definetoken{a}{injective}{}
\definetoken{A}{injective}{}
\definetoken{a}{injection}{}
\definetoken{A}{injection}{}
\definetoken{a}{surjective}{}
\definetoken{A}{surjective}{}
\definetoken{a}{surjection}{}
\definetoken{A}{surjection}{}
\definetoken{a}{bijective}{}
\definetoken{A}{bijective}{}
\definetoken{a}{bijection}{}
\definetoken{A}{bijection}{}

% Token logika yang pertama kali muncul pada bab Pohon dan akan dipakai
% kembali dalam sintaks serta teori bukti.
\settexttoken{formula}*{formula}{formula}
\settexttoken{derivation}*{derivasi}{derivasi}
\definetoken{a}{formula}{}
\definetoken{A}{formula}{}
\definetoken{a}{derivation}{}
\definetoken{A}{derivation}{}

% Istilah dasar sintaks dan semantik proposisional. Bahasa Indonesia tidak
% menandai jamak pada nomina ini melalui sufiks, dan artikel a/A dikosongkan.
\settexttoken{propositional variable}{variabel proposisi}{variabel proposisi}[Variabel proposisi][Variabel proposisi]
\settexttoken{operator}{operator logis}{operator logis}[Operator logis][Operator logis]
\settexttoken{conditional}{implikasi}{implikasi}[Implikasi][Implikasi]
\settexttoken{biconditional}{biimplikasi}{biimplikasi}[Biimplikasi][Biimplikasi]
\settexttoken{falsity}{kepalsuan}{kepalsuan}[Kepalsuan][Kepalsuan]
\settexttoken{truth}{kebenaran}{kebenaran}[Kebenaran][Kebenaran]
\settexttoken{structure}{struktur}{struktur}[Struktur][Struktur]
\settexttoken{valuation}{valuasi}{valuasi}[Valuasi][Valuasi]
\definetoken{a}{propositional variable}{}
\definetoken{A}{propositional variable}{}
\definetoken{a}{operator}{}
\definetoken{A}{operator}{}
\definetoken{a}{conditional}{}
\definetoken{A}{conditional}{}
\definetoken{a}{biconditional}{}
\definetoken{A}{biconditional}{}
\definetoken{a}{falsity}{}
\definetoken{A}{falsity}{}
\definetoken{a}{truth}{}
\definetoken{A}{truth}{}
\definetoken{a}{structure}{}
\definetoken{A}{structure}{}
\definetoken{a}{valuation}{}
\definetoken{A}{valuation}{}

% Istilah teori bukti yang pertama kali diperlukan oleh ikhtisar sistem
% pembuktian. Bentuk nomina tidak berubah untuk jamak; artikel bahasa
% Inggris dikosongkan. Infleksi pasif verba tetap ditangani dalam kalimat
% target apabila sufiks bahasa Inggris pada sumber tidak dapat dipertahankan.
\settexttoken{sentence}{kalimat}{kalimat}[Kalimat][Kalimat]
\settexttoken{derive}{menurunkan}{menurunkan}[Menurunkan][Menurunkan]
\settexttoken{derivable}{dapat diturunkan}{dapat diturunkan}[Dapat diturunkan][Dapat diturunkan]
\settexttoken{derivability}{keterderivasian}{keterderivasian}[Keterderivasian][Keterderivasian]
\settexttoken{tableau}{tableau}{tableau}[Tableau][Tableau]
\settexttoken{signed formula}{formula bertanda}{formula bertanda}[Formula bertanda][Formula bertanda]
\settexttoken{discharge}{melepaskan}{melepaskan}[Melepaskan][Melepaskan]
\settexttoken{discharged}{dilepaskan}{dilepaskan}[Dilepaskan][Dilepaskan]
\settexttoken{undischarged}{belum dilepaskan}{belum dilepaskan}[Belum dilepaskan][Belum dilepaskan]
\definetoken{a}{sentence}{}
\definetoken{A}{sentence}{}
\definetoken{a}{tableau}{}
\definetoken{A}{tableau}{}
\definetoken{a}{signed formula}{}
\definetoken{A}{signed formula}{}

% Kanon pembanding UIN KHAS membedakan "himpunan terhitung" dari
% "himpunan takterhitung" dan mencatat "terbilang" untuk himpunan tak
% hingga yang dapat dipasangkan satu-satu dengan bilangan asli. Bentuk ini
% mengikat token countability tanpa mengubah definisi matematis sumber.
\settexttoken{enumerable}*{terhitung}{terhitung}
\settexttoken{nonenumerable}{takterhitung}{takterhitung}
\settexttoken{denumerable}{terbilang}{terbilang}
\definetoken{a}{enumerable}{}
\definetoken{A}{enumerable}{}
\definetoken{a}{nonenumerable}{}
\definetoken{A}{nonenumerable}{}
\definetoken{a}{denumerable}{}
\definetoken{A}{denumerable}{}
