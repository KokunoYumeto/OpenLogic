% Teks lisensi dan atribusi. Perintah ini sudah didefinisikan oleh
% berkas lokal Inggris, sehingga pelokalan harus memperbaruinya.

\renewcommand*{\ollicensetext}[3]
  {\textit{#1}
  oleh
  #2
  dilisensikan berdasarkan
  #3.}
\renewcommand*{\olshortlicensetext}[1]
  {\textit{\href{\OLTlinkname}{\jobname}}
  \ifgitinfo\ 
  oleh #1 /
  \href{http://creativecommons.org/licenses/by/4.0/}{CC--BY}.}
\renewcommand*{\oluselicensetext}
  {Karya ini didasarkan pada
  \textit{\href{\OLTlinkname}{\OLTname}}
  oleh
  \href{http://openlogicproject.org/}{\OLPname},
  yang digunakan berdasarkan
  \href{http://creativecommons.org/licenses/by/4.0/}{\licensename}.}
\renewcommand*{\olshortuselicensetext}[2]
  {\textit{#1}
  oleh #2, berdasarkan
  \href{http://openlogicproject.org/}{OLP} /
  \href{http://creativecommons.org/licenses/by/4.0/}{CC--BY}.}

